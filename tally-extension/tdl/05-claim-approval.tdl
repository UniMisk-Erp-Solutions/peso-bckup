[Field : PW CA Foot Count]
Use : Name Field
Set as : "All 19 fixed claim fields, including mapped LPO. Scroll horizontally and vertically; Enter opens details."
Width : 80

[Key : PW CA Line Enter]
Key : Enter
Action : CALL : PW CA Show Detail

[Function : PW CA Show Detail]
01 : SET : SV PW Ledger Name : $Name
02 : Display : PW Claim Approval Detail

[Report : PW Claim Approval Detail]
Use : DSP Template
Form : PW CA Detail Form
Title : "Claim Approval Details"

[Form : PW CA Detail Form]
Part : PW CA Det Head, PW CA Det Body
Height : 100% Screen
Width : 100% Screen

[Part : PW CA Det Head]
