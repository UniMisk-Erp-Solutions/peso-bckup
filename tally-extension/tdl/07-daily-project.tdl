[Report : PW Daily Project List]
Use : DSP Template
Form : PW DPR List Form
Title : "Daily Project Report (PesoWise)"

[Form : PW DPR List Form]
Set : PW Active Title : "Daily Project Report"
Part : PW Shell Header Part, PW DPR Diagnostic Part, PW DPR Grid Part, PW DPR Footer Part
Height : 100% Screen

;; Visible runtime diagnostic: distinguishes an empty collection from a row-layout issue.
[Part : PW DPR Diagnostic Part]
Lines : PW DPR Diagnostic Line

[Line : PW DPR Diagnostic Line]
Fields : PW DPR Diagnostic Label, PW DPR Diagnostic Count

[Field : PW DPR Diagnostic Label]
Use : Name Field
Set as : "Matching Tally ledgers (Daily Project):"
Width : 38

[Field : PW DPR Diagnostic Count]
Use : Number Field
Set as : $$NumItems:PWDPRLatest
Width : 12

[Part : PW DPR Grid Part]
Lines : PW DPR Col Head Line, PW DPR Data Line
Repeat : PW DPR Data Line : PWDPRLatest
Scroll : Both
Common Border : Yes

