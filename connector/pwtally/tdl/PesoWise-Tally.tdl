;; PesoWise -> TallyPrime reports (pwt). GENERATED by connector/pwtally/scripts/gen-tdl.mjs - do not edit by hand.
;; Read-only. Rows are aggregated five-column results synchronised from PesoWise (ledgers in group 'PesoWise Report Data').

[System : UDF]
PWTREPORT : String : 26101
PWTKEY : String : 26102
PWTREV : String : 26103
PWTJOB : String : 26104
PWTCELLS : String : 26105

[#Menu : Gateway of Tally]
Add : Key Item : PesoWise Reports : W : Menu : PWT Reports Menu

[Menu : PWT Reports Menu]
Title : "PesoWise Reports"
Key Item : Daily Project : D : Display : PWT DP List
Key Item : Detailed Expense : E : Display : PWT DE List
Key Item : Claim Verification : V : Display : PWT CV List
Key Item : Claim Approval : A : Display : PWT CA List

;; Token n (1-based) of a pipe-delimited flat row. __PW_EMPTY__ marks blank cells.
[Function : PWT Tok]
Parameter : PWTFlat : String
Parameter : PWTIdx : Number
Variable : PWTRes : String
Variable : PWTCnt : Number
00 : SET : PWTRes : ""
10 : SET : PWTCnt : 0
20 : FOR TOKEN : PWTTokVal : ##PWTFlat : "|"
30 : INCREMENT : PWTCnt
40 : IF : ##PWTCnt = ##PWTIdx
50 : IF : ##PWTTokVal = "__PW_EMPTY__"
60 : SET : PWTRes : ""
70 : ELSE
80 : SET : PWTRes : ##PWTTokVal
90 : END IF
100 : END IF
110 : END FOR
120 : RETURN : ##PWTRes

[Function : PWT Num]
Parameter : PWTFlat : String
Parameter : PWTIdx : Number
Returns : Number
Variable : PWTNumTmp : String
00 : SET : PWTNumTmp : $$PWTTok:##PWTFlat:##PWTIdx
10 : RETURN : $$Number:##PWTNumTmp

[Style : PWT Head Style]
Font : Arial Bold
Height : 11

[Style : PWT Title Style]
Font : Arial Bold
Height : 14

[Style : PWT Row Style]
Font : Arial
Height : 11

[System : Formula]
PWT DP Filt : $PWTREPORT = "daily_project"

[Collection : PWTDPRows]
Type : Ledger
Fetch : Name, PWTREPORT, PWTKEY, PWTREV, PWTCELLS
Filter : PWT DP Filt
Compute : PWTN7 : $$PWTNum:$PWTCELLS:7
Sort : @@Default : $PWTCELLS

[Report : PWT DP List]
Use : DSP Template
Form : PWT DP List Form
Title : "PesoWise Daily Project"

[Form : PWT DP List Form]
Part : PWT DP Head Part, PWT DP Grid Part, PWT DP Foot Part
Height : 100% Screen
Width : 100% Screen

[Part : PWT DP Head Part]
Line : PWT DP Co Line, PWT DP Title Line, PWT DP Sub Line
[Line : PWT DP Co Line]
Field : PWT DP Co Field
[Field : PWT DP Co Field]
Use : Short Name Field
Set as : $$CurrentCompany
Width : 98% Page
Align : Centre
Style : PWT Title Style
Skip : Yes

[Line : PWT DP Title Line]
Field : PWT DP Title Field
[Field : PWT DP Title Field]
Use : Short Name Field
