;; PesoWise -> TallyPrime reports (pwt). GENERATED by connector/pwtally/scripts/gen-tdl.mjs - do not edit by hand.
;; Read-only. Detailed Expense is the only report: it shows the REAL vouchers created in this company (one row per employee line of each
;; 'PWT PESO/..' Journal voucher, read live from the books).

[System : UDF]
PWTREPORT : String : 26101
PWTKEY : String : 26102
PWTREV : String : 26103
PWTJOB : String : 26104
PWTCELLS : String : 26105

[#Menu : Gateway of Tally]
Add : Key Item : PesoWise Reports : W : Menu : PWT Reports Menu

[Menu : PWT Reports Menu]
Title : "PesoWise Reports"
Key Item : Detailed Expense : E : Display : PWT DE List

;; Token n (1-based) of a pipe-delimited flat row. __PW_EMPTY__ marks blank cells.
[Function : PWT Tok]
Parameter : PWTFlat : String
Parameter : PWTIdx : Number
Variable : PWTRes : String
Variable : PWTCnt : Number
00 : SET : PWTRes : ""
10 : SET : PWTCnt : 0
20 : FOR TOKEN : PWTTokVal : ##PWTFlat : "|"
30 : INCREMENT : PWTCnt
40 : IF : ##PWTCnt = ##PWTIdx
50 : IF : ##PWTTokVal = "__PW_EMPTY__"
60 : SET : PWTRes : ""
70 : ELSE
80 : SET : PWTRes : ##PWTTokVal
90 : END IF
100 : END IF
110 : END FOR
120 : RETURN : ##PWTRes

[Function : PWT Num]
Parameter : PWTFlat : String
Parameter : PWTIdx : Number
Returns : Number
Variable : PWTNumTmp : String
00 : SET : PWTNumTmp : $$PWTTok:##PWTFlat:##PWTIdx
10 : RETURN : $$Number:##PWTNumTmp

[Style : PWT Head Style]
Font : Arial Bold
Height : 11

[Style : PWT Title Style]
Font : Arial Bold
Height : 14

[Style : PWT Row Style]
Font : Arial
Height : 11

[Collection : PWTVchSrc]
Type : Voucher

[Collection : PWTVchLines]
Source Collection : PWTVchSrc
Walk : AllLedgerEntries
Compute : PWTLed : $LedgerName
Compute : PWTAmt : $Amount
Compute : PWTExp : $$Owner:$LedgerName
Compute : PWTDt : $$Owner:$Date
Compute : PWTId : $$Owner:$Narration
Compute : PWTDeem : $IsDeemedPositive
Compute : PWTCr : if $IsDeemedPositive then 0 else (if $$Owner:$Narration Contains "PWT PESO/" then $$Number:$Amount else 0)
Compute : PWTOne : if $IsDeemedPositive then 0 else (if $$Owner:$Narration Contains "PWT PESO/" then 1 else 0)

[Report : PWT DE List]
Use : DSP Template
Form : PWT DE List Form
Title : "PesoWise Detailed Expense"

[Form : PWT DE List Form]
Part : PWT DE Head Part, PWT DE Grid Part, PWT DE Foot Part
Height : 100% Screen
Width : 100% Screen

[Part : PWT DE Head Part]
Line : PWT DE Co Line, PWT DE Title Line, PWT DE Sub Line
[Line : PWT DE Co Line]
Field : PWT DE Co Field
[Field : PWT DE Co Field]
Use : Short Name Field
Set as : $$CurrentCompany
Width : 98% Page
Align : Centre
Style : PWT Title Style
Skip : Yes

[Line : PWT DE Title Line]
Field : PWT DE Title Field
[Field : PWT DE Title Field]
Use : Short Name Field
Set as : "PesoWise Detailed Expense"
Width : 98% Page
Align : Centre
Style : PWT Head Style
Skip : Yes

[Line : PWT DE Sub Line]
Field : PWT DE Sub Label, PWT DE Sub Count
[Field : PWT DE Sub Label]
Use : Short Name Field
Set as : "Employee lines of the PesoWise vouchers in this company:"
Width : 38% Page
Style : PWT Row Style
Skip : Yes
[Field : PWT DE Sub Count]
Use : Short Name Field
Type : Number
Set as : $$CollNumTotal:PWTVchLines:$PWTOne
Width : 8% Page
Style : PWT Head Style
Skip : Yes

[Part : PWT DE Grid Part]
Line : PWT DE Col Head Line, PWT DE Data Line
Repeat : PWT DE Data Line : PWTVchLines
Scroll : Vertical
Common Border : Yes

[Line : PWT DE Col Head Line]
Field : PWT DE H1, PWT DE H2, PWT DE H3, PWT DE H4, PWT DE H5
Border : Thin Box
[Line : PWT DE Data Line]
Field : PWT DE D1, PWT DE D2, PWT DE D3, PWT DE D4, PWT DE D5
Border : Thin Bottom
Invisible : $PWTDeem = "Yes" OR NOT $PWTId Contains "PWT PESO/"

[Field : PWT DE H1]
Use : Short Name Field
Set as : "Voucher Date (Tally)"
Width : 14% Page
Border : Thin Left
Align : Centre
Style : PWT Head Style
Skip : Yes
[Field : PWT DE D1]
Use : Short Name Field
Set as : $PWTDt
Width : 14% Page
Border : Thin Left
Align : Left
Style : PWT Row Style
Skip : Yes

[Field : PWT DE H2]
Use : Short Name Field
Set as : "Expense Ledger"
Width : 27% Page
Border : Thin Left
Align : Centre
Style : PWT Head Style
Skip : Yes
[Field : PWT DE D2]
Use : Short Name Field
Set as : $PWTExp
Width : 27% Page
Border : Thin Left
Align : Left
Style : PWT Row Style
Skip : Yes

[Field : PWT DE H3]
Use : Short Name Field
Set as : "Employe Ledger"
Width : 33% Page
Border : Thin Left
Align : Centre
Style : PWT Head Style
Skip : Yes
[Field : PWT DE D3]
Use : Short Name Field
Set as : $PWTLed
Width : 33% Page
Border : Thin Left
Align : Left
Style : PWT Row Style
Skip : Yes

[Field : PWT DE H4]
Use : Short Name Field
Set as : "Voucher ID"
Width : 12% Page
Border : Thin Left
Align : Centre
Style : PWT Head Style
Skip : Yes
[Field : PWT DE D4]
Use : Short Name Field
Set as : $$StringPart:$PWTId:4:30
Width : 12% Page
Border : Thin Left
Align : Left
Style : PWT Row Style
Skip : Yes

[Field : PWT DE H5]
Use : Short Name Field
Set as : "Total"
Width : 12% Page
Border : Thin Left
Align : Centre
Style : PWT Head Style
Skip : Yes
[Field : PWT DE D5]
Use : Short Name Field
Set as : $$Number:$PWTAmt
Width : 12% Page
Border : Thin Left
Align : Right
Style : PWT Row Style
Skip : Yes

[Part : PWT DE Foot Part]
Line : PWT DE Total Line
Border : Thin Box
[Line : PWT DE Total Line]
Field : PWT DE T1, PWT DE T2, PWT DE T3, PWT DE T4, PWT DE T5
[Field : PWT DE T1]
Use : Short Name Field
Set as : "Grand Total"
Width : 14% Page
Border : Thin Left
Align : Left
Style : PWT Head Style
Skip : Yes
[Field : PWT DE T2]
Use : Short Name Field
Set as : ""
Width : 27% Page
Border : Thin Left
Align : Left
Style : PWT Head Style
Skip : Yes
[Field : PWT DE T3]
Use : Short Name Field
Set as : ""
Width : 33% Page
Border : Thin Left
Align : Left
Style : PWT Head Style
Skip : Yes
[Field : PWT DE T4]
Use : Short Name Field
Set as : ""
Width : 12% Page
Border : Thin Left
Align : Left
Style : PWT Head Style
Skip : Yes
[Field : PWT DE T5]
Use : Short Name Field
Type : Number
Format : "Decimals:2"
Set as : $$CollNumTotal:PWTVchLines:$PWTCr
Width : 12% Page
Border : Thin Left
Align : Right
Style : PWT Head Style
Skip : Yes

