# Copy to `.env` / `.env.local` for local dev. Set in Vercel/hosting for production.

# Supabase — SELF-HOSTED PesoWise project (frontend — publishable/anon key only;
# NEVER prefix service role with VITE_). This is the LOCAL application database —
# auth, organizations, expenses, everything the product does. See the separate
# "Cloud maintenance control plane" section near the bottom of this file for the
# UNRELATED, second Supabase project used only for maintenance status.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Self-hosted example: VITE_SUPABASE_URL=https://pesowise-supabase.unimisk.com
# VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# Admin user creation uses Edge Function `admin-create-user` (service role stays server-side).
#
# CSP (production): self-hosted Supabase host must appear in vercel.json connect-src /
# wss:// (currently https://pesowise-supabase.unimisk.com + https://*.unimisk.com).
# Redeploy Vercel after changing VITE_SUPABASE_URL or CSP.

# Cloudflare Turnstile (required when Supabase Auth → CAPTCHA protection is enabled)
# Site key from Cloudflare dashboard; secret key goes in Supabase Auth settings only.
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# GlitchTip error monitoring (Sentry-compatible). DSN is safe to expose client-side.
# Find it in GlitchTip → Pesowise org → project → Settings → Client Keys (DSN).
# The DSN host must also be in vercel.json connect-src (https://error-kidzo.unimisk.com).
# Leave unset to disable monitoring in local/dev. Redeploy Vercel after setting.
# VITE_GLITCHTIP_DSN=https://PUBLIC_KEY@error-kidzo.unimisk.com/PROJECT_ID

# Optional: local backup/restore scripts only (not used by the React app)
# Must match VITE_SUPABASE_URL project ref (same project as production app).
# Direct DB URL — required for storage policy SQL (npm run post-restore:storage-policies)
# DATABASE_DIRECT_URL=postgresql://postgres:***REMOVED-SENSITIVE-VALUE***@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional pooler URL for other scripts:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:***REMOVED-SENSITIVE-VALUE***@aws-0-REGION.pooler.supabase.com:5432/postgres
# Self-hosted Coolify Postgres (for npm run post-restore:auth-null-tokens after backup restore):
# COOLIFY_DATABASE_URL=postgresql://postgres:***REMOVED-SENSITIVE-VALUE***@HOST:5432/postgres
# Self-hosted Coolify edge functions (for npm run deploy:edge-functions):
# COOLIFY_SSH=root@YOUR_SERVER_IP
# COOLIFY_FUNCTIONS_PATH=/data/coolify/services/YOUR_SERVICE_ID/volumes/functions
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key  # storage backup script only; never VITE_
# BACKUP_DIR=D:\pesowise_backups\supabase_backup_2026-05-29  # optional output folder

# Shared app hostname (apex). Tenant hosts use {subdomain}.{VITE_APP_BASE_DOMAIN}
# VITE_APP_BASE_DOMAIN=pesowise.unimisk.com

# Local dev only: pretend you are on a tenant subdomain (e.g. ml) while using localhost.
# Optional if you use the tenant dropdown on the login page (localhost only).
# VITE_DEV_TENANT_SUBDOMAIN=ml

# Domain for synthetic auth emails when org feature "user_email_auto" is on (must be a domain you control)
# VITE_SYNTHETIC_EMAIL_DOMAIN=users.unimisk.com

# Canonical site origin (no trailing slash). Used for JSON-LD and absolute canonical URLs.
# VITE_PUBLIC_SITE_URL=https://pesowise.unimisk.com
# URL used by account-created emails for sign-in CTA
# VITE_APP_SIGNIN_URL=https://pesowise.unimisk.com/auth

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Omit to disable analytics.
# VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification — content value only.
# Prefer DNS TXT verification when possible; this is optional.
# VITE_GSC_VERIFICATION=

# Social profile URLs (footer). Leave blank to hide Instagram/YouTube until live.
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/pesowise
# VITE_SOCIAL_TWITTER_URL=https://twitter.com/pesowise
# VITE_SOCIAL_INSTAGRAM_URL=
# VITE_SOCIAL_YOUTUBE_URL=

# --- Review Expenses rollout (DOC-080) -------------------------------------
# Swaps the DATA LAYER behind /review to the proven server queue. The page looks
# the same; only the fetching changes. Default false = existing EngineerReview.
# VITE_REVIEW_EXPENSES_SERVER_QUEUE_ENABLED=false
# Enables verify/approve/reject/correct on the server-backed page. Kept separate
# because a working read-only queue is not evidence that mutations are safe.
# VITE_REVIEW_EXPENSES_SERVER_ACTIONS_ENABLED=false

# Independent /debug/review-expenses validation surface. Own flags, so turning
# one pair off never affects the other.
# VITE_DEBUG_REVIEW_EXPENSES_ENABLED=false
# VITE_DEBUG_REVIEW_ACTIONS_ENABLED=false

# --- Cloud maintenance control plane -----------------------------------------
# docs/maintenance/CLOUD_MAINTENANCE_CONTROL_PLANE.md
#
# A SEPARATE, independent Supabase Cloud project used ONLY to answer "is
# PesoWise in maintenance?" — never the self-hosted project above, never any
# PesoWise business data. Do NOT reuse VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY
# here, and do not put these values there.
#
# Left disabled (VITE_MAINTENANCE_CONTROL_ENABLED=false) until the Cloud
# project is created and tested — an unconfigured deployment must never
# depend on Cloud (fail-open by design; see the architecture doc §2/§17).
#
# Publishable (anon) key only — NEVER a service_role key, a Cloud project
# "secret" API key, or the Cloud database password/connection string, in
# this or any VITE_-prefixed variable.
# VITE_MAINTENANCE_SUPABASE_URL=https://YOUR_MAINTENANCE_PROJECT_REF.supabase.co
# VITE_MAINTENANCE_SUPABASE_PUBLISHABLE_KEY=your_maintenance_project_anon_key
# VITE_MAINTENANCE_ENV=preview
# VITE_MAINTENANCE_CONTROL_ENABLED=false
# VITE_MAINTENANCE_REQUEST_TIMEOUT_MS=2500
#
# Background polling — exists only to pick up admin-made changes and refresh
# a trusted lease before it would otherwise expire, never to determine
# transition precision (exact local timers own that — see the architecture
# doc §34.5/§34.6). Optional; both default to 120000 (120s).
# VITE_MAINTENANCE_POLL_INTERVAL_NORMAL_MS=120000
# VITE_MAINTENANCE_POLL_INTERVAL_ACTIVE_MS=120000
#
# How long a forced-maintenance lease survives with no fresh Cloud
# confirmation before failing open. Optional; defaults to 180000 (3 minutes).
# VITE_MAINTENANCE_ACTIVE_FAILURE_GRACE_MS=180000
