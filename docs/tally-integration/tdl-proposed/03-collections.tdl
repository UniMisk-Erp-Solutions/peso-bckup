;; Latest-revision collections (one row per metadata_delivery_key).

[Collection : PW Claim Ver Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : $$And:@@PWFiltClaimVer:@@PWIsLatestRow
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_META_DELIVERY_KEY, PESOWISE_META_REVISION, PESOWISE_META_JSON_PLAIN, PESOWISE_METADATA_JSON, PESOWISE_REPORT_TYPE

[Collection : PW Claim Ap Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : $$And:@@PWFiltClaimAp:@@PWIsLatestRow
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_META_DELIVERY_KEY, PESOWISE_META_REVISION, PESOWISE_META_JSON_PLAIN, PESOWISE_METADATA_JSON, PESOWISE_REPORT_TYPE

[Collection : PW Detailed Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : $$And:@@PWFiltDetailed:@@PWIsLatestRow
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_META_DELIVERY_KEY, PESOWISE_META_REVISION, PESOWISE_META_JSON_PLAIN, PESOWISE_METADATA_JSON, PESOWISE_REPORT_TYPE

[Collection : PW DPR Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : $$And:@@PWFiltDaily:@@PWIsLatestRow
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_META_DELIVERY_KEY, PESOWISE_META_REVISION, PESOWISE_META_JSON_PLAIN, PESOWISE_METADATA_JSON, PESOWISE_REPORT_TYPE
Fetch : PESOWISE_DPR_TRACK_DATE, PESOWISE_DPR_VOUCHER_NO, PESOWISE_DPR_PROJECT_NAME, PESOWISE_DPR_EMPLOYEE, PESOWISE_DPR_LOCATION, PESOWISE_DPR_PRESENCE, PESOWISE_DPR_REMARKS

[Collection : PW Selected Ledger One]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : $Name = ##SVPWLedgerName
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_META_JSON_PLAIN, PESOWISE_METADATA_JSON
Fetch : PESOWISE_DPR_TRACK_DATE, PESOWISE_DPR_VOUCHER_NO, PESOWISE_DPR_PROJECT_ID, PESOWISE_DPR_PROJECT_NAME
Fetch : PESOWISE_DPR_EMPLOYEE, PESOWISE_DPR_EMPLOYEE_CODE, PESOWISE_DPR_LOCATION, PESOWISE_DPR_REMARKS, PESOWISE_DPR_PRESENCE
Fetch : PESOWISE_DPR_PETROL_COST, PESOWISE_DPR_MATERIAL_COST, PESOWISE_DPR_TRAVELLING_COST, PESOWISE_DPR_PHONE_EXP
Fetch : PESOWISE_DPR_HOTEL_EXP, PESOWISE_DPR_TRANSPORT_EXP, PESOWISE_DPR_CONTRA_BILL, PESOWISE_DPR_OTHER_EXP, PESOWISE_DPR_PERCENT
