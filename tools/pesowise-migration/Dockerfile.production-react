# PesoWise production React (API backend — no Supabase runtime).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY . .
ARG VITE_API_URL=http://192.168.23.46:8787
ARG VITE_PUBLIC_SITE_URL=http://192.168.23.46:4173
ARG VITE_APP_BASE_DOMAIN=pesowise.unimisk.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL
ENV VITE_APP_BASE_DOMAIN=$VITE_APP_BASE_DOMAIN
ENV VITE_MIGRATION_STAGING=false
ENV VITE_SUPABASE_URL=
ENV VITE_SUPABASE_ANON_KEY=
ENV VITE_SUPABASE_PUBLISHABLE_KEY=
RUN npm run build:keep-maps

FROM nginx:alpine
COPY tools/pesowise-migration/nginx-staging-react.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
