;; PesoWise Bootstrap — UDF slot declarations ONLY (no ledger form hooks).
;; Ledger [#Part : Led Other Details] hooks were removed: binding/display of
;; PESOWISE_METADATA_JSON on master alter caused c0000005 with large sync payloads.

[System : UDF]
PESOWISE_METADATA_JSON : String : 25001
PESOWISE_REPORT_TYPE : String : 25002
PESOWISE_META_REVISION : String : 25003
PESOWISE_META_DELIVERY_KEY : String : 25005
PESOWISE_DPR_TRACK_DATE : String : 25010
PESOWISE_DPR_VOUCHER_NO : String : 25011
PESOWISE_DPR_PROJECT_ID : String : 25012
PESOWISE_DPR_PROJECT_NAME : String : 25013
PESOWISE_DPR_EMPLOYEE : String : 25014
PESOWISE_DPR_EMPLOYEE_CODE : String : 25015
PESOWISE_DPR_LOCATION : String : 25016
PESOWISE_DPR_REMARKS : String : 25017
PESOWISE_DPR_PETROL_COST : String : 25018
PESOWISE_DPR_MATERIAL_COST : String : 25019
PESOWISE_DPR_TRAVELLING_COST : String : 25020
PESOWISE_DPR_PHONE_EXP : String : 25021
PESOWISE_DPR_HOTEL_EXP : String : 25022
PESOWISE_DPR_TRANSPORT_EXP : String : 25023
PESOWISE_DPR_CONTRA_BILL : String : 25024
PESOWISE_DPR_OTHER_EXP : String : 25025
PESOWISE_DPR_PERCENT : String : 25026
PESOWISE_DPR_PRESENCE : String : 25027
PESOWISE_REPORT_FLAT_ROW : String : 25028
PESOWISE_SYNC_RUN_ID : String : 25030
PESOWISE_META_JSON_PLAIN : String : 25029

[Variable : SV PW Ledger Name]
Type : String
Volatile : Yes

[Variable : PW Active Title]
Type : String
Volatile : Yes
