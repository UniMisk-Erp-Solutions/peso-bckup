;; Shared formulas, variables, styles, and shell parts for PesoWise reports v2.
;; Reports MUST NOT evaluate PESOWISE_METADATA_JSON at runtime (c0000005 risk).

[System : Formula]
PW Flat 1 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:1
[System : Formula]
PW Flat 2 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:2
[System : Formula]
PW Flat 3 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:3
[System : Formula]
PW Flat 4 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:4
[System : Formula]
PW Flat 5 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:5
[System : Formula]
PW Flat 6 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:6
[System : Formula]
PW Flat 7 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:7
[System : Formula]
PW Flat 8 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:8
[System : Formula]
PW Flat 9 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:9
[System : Formula]
PW Flat 10 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:10
[System : Formula]
PW Flat 11 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:11
[System : Formula]
PW Flat 12 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:12
[System : Formula]
PW Flat 13 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:13
[System : Formula]
PW Flat 14 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:14
[System : Formula]
PW Flat 15 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:15
[System : Formula]
PW Flat 16 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:16
[System : Formula]
PW Flat 17 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:17
[System : Formula]
PW Flat 18 : $$StringPart:$PESOWISE_REPORT_FLAT_ROW:|:18

[System : Formula]
PW Filt Claim Ver : $$StringEqual:$PESOWISE_REPORT_TYPE:"claim_verification"
[System : Formula]
PW Filt Claim Ap : $$StringEqual:$PESOWISE_REPORT_TYPE:"claim_approval"
[System : Formula]
PW Filt Detailed : $$StringEqual:$PESOWISE_REPORT_TYPE:"detailed_expense"
[System : Formula]
;; TallyGold-safe: single equality only (no $$Or in collection filters).
PW Filt Daily : $$StringEqual:$PESOWISE_REPORT_TYPE:"daily_project_report"
[System : Formula]
;; Daily list: any metadata ledger with a DPR track date (works even if REPORT_TYPE was missing on old imports).
PW Filt DPR Track : $$Not:$$IsEmpty:$PESOWISE_DPR_TRACK_DATE

[System : Formula]
PW Sel Ledger Match : $Name = ##SVPWLedgerName

[System : Formula]
PW DPR Row Total : $$Number:@@PWFlat9 + $$Number:@@PWFlat10 + $$Number:@@PWFlat11 + $$Number:@@PWFlat12 + $$Number:@@PWFlat13 + $$Number:@@PWFlat14 + $$Number:@@PWFlat15 + $$Number:@@PWFlat16

[System : Formula]
PW DE Row Amount : $$If:$$Number:@@PWFlat12 > 0:$$Number:@@PWFlat12:$$Number:@@PWFlat11

[System : Formula]
PW DPR Presence Label : $$If:$$IsEmpty:$PESOWISE_DPR_PRESENCE:"Present":$PESOWISE_DPR_PRESENCE

[System : Formula]
PW CV Row Amount : $$Number:@@PWFlat12

[Style : PW Title Style]
Font : Arial Bold
Height : 12

[Style : PW Subtitle Style]
Font : Arial
Height : 10

[Style : PW Col Head Style]
Font : Arial Bold
Height : 9

[Part : PW Shell Header Part]
Lines : PW Shell Brand, PW Shell Title, PW Shell Sub, PW Shell Period, PW Shell Rule
Border : Thin Bottom

[Line : PW Shell Brand]
Field : PW Shell Brand F
[Field : PW Shell Brand F]
Use : Name Field
Set as : "PesoWise"
Style : PW Title Style
Full Width : Yes

[Line : PW Shell Title]
Field : PW Shell Title F
[Field : PW Shell Title F]
Use : Name Field
Set as : ##PWActiveTitle
Style : PW Title Style
Full Width : Yes

[Line : PW Shell Sub]
Field : PW Shell Sub F
[Field : PW Shell Sub F]
Use : Name Field
Set as : "Synced from PesoWise"
Style : PW Subtitle Style
Full Width : Yes

[Line : PW Shell Period]
Field : PW Shell Period F
[Field : PW Shell Period F]
Use : Name Field
Set as : "Period: As of last sync job in PesoWise"
Style : PW Subtitle Style
Full Width : Yes

[Line : PW Shell Rule]
Field : PW Shell Rule F
[Field : PW Shell Rule F]
Use : Name Field
Set as : " "
Full Width : Yes

[Part : PW Shell Empty Part]
Lines : PW Empty Sp1, PW Empty L1, PW Empty L2, PW Empty Sp2

[Line : PW Empty Sp1]
Field : PW Empty Sp1 F
[Field : PW Empty Sp1 F]
Use : Name Field
Set as : " "
Full Width : Yes

[Line : PW Empty L1]
Field : PW Empty L1 F
[Field : PW Empty L1 F]
Use : Name Field
Set as : "No PesoWise data available"
Style : PW Title Style
Align : Center
Full Width : Yes

[Line : PW Empty L2]
Field : PW Empty L2 F
[Field : PW Empty L2 F]
Use : Name Field
Set as : "Sync this report from PesoWise to view it here."
Style : PW Subtitle Style
Align : Center
Full Width : Yes

[Line : PW Empty Sp2]
Field : PW Empty Sp2 F
[Field : PW Empty Sp2 F]
Use : Name Field
Set as : " "
Full Width : Yes

[Line : PW Detail Label Value]
Fields : PW Detail Label F, PW Detail Value F

[Field : PW Detail Label F]
Use : Name Field
Width : 28
Style : PW Col Head Style

[Field : PW Detail Value F]
Use : Name Field
Width : 52
Full Width : Yes
