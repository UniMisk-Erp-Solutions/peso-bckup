;; Ledger collections — typed UDF fields only (never fetch JSON UDFs at report time).

[Collection : PW Claim Ver Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : PWFiltClaimVer
Fetch : Name, PESOWISE_REPORT_TYPE, PESOWISE_REPORT_FLAT_ROW

[Collection : PW Claim Ap Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : PWFiltClaimAp
Fetch : Name, PESOWISE_REPORT_TYPE, PESOWISE_REPORT_FLAT_ROW

[Collection : PW Detailed Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : PWFiltDetailed
Fetch : Name, PESOWISE_REPORT_TYPE, PESOWISE_REPORT_FLAT_ROW

[Collection : PW DPR Latest]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : PWFiltDPRTrack
Fetch : Name, PESOWISE_REPORT_TYPE, PESOWISE_REPORT_FLAT_ROW
Fetch : PESOWISE_DPR_TRACK_DATE, PESOWISE_DPR_VOUCHER_NO, PESOWISE_DPR_PROJECT_ID, PESOWISE_DPR_PROJECT_NAME
Fetch : PESOWISE_DPR_EMPLOYEE, PESOWISE_DPR_EMPLOYEE_CODE, PESOWISE_DPR_LOCATION, PESOWISE_DPR_PRESENCE, PESOWISE_DPR_REMARKS
Fetch : PESOWISE_DPR_PETROL_COST, PESOWISE_DPR_MATERIAL_COST, PESOWISE_DPR_TRAVELLING_COST, PESOWISE_DPR_PHONE_EXP
Fetch : PESOWISE_DPR_HOTEL_EXP, PESOWISE_DPR_TRANSPORT_EXP, PESOWISE_DPR_CONTRA_BILL, PESOWISE_DPR_OTHER_EXP, PESOWISE_DPR_PERCENT

[Collection : PW Selected Ledger One]
Type : Ledger
Child Of : "PesoWise Metadata"
Filter : PWSelLedgerMatch
Fetch : Name, PESOWISE_REPORT_FLAT_ROW, PESOWISE_REPORT_TYPE
Fetch : PESOWISE_DPR_TRACK_DATE, PESOWISE_DPR_VOUCHER_NO, PESOWISE_DPR_PROJECT_ID, PESOWISE_DPR_PROJECT_NAME
Fetch : PESOWISE_DPR_EMPLOYEE, PESOWISE_DPR_EMPLOYEE_CODE, PESOWISE_DPR_LOCATION, PESOWISE_DPR_REMARKS, PESOWISE_DPR_PRESENCE
Fetch : PESOWISE_DPR_PETROL_COST, PESOWISE_DPR_MATERIAL_COST, PESOWISE_DPR_TRAVELLING_COST, PESOWISE_DPR_PHONE_EXP
Fetch : PESOWISE_DPR_HOTEL_EXP, PESOWISE_DPR_TRANSPORT_EXP, PESOWISE_DPR_CONTRA_BILL, PESOWISE_DPR_OTHER_EXP, PESOWISE_DPR_PERCENT
