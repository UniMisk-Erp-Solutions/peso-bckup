Set as : "Amount"
Style : PW Col Head Style
Width : 12
Align : Right
[Field : PW DE C Ev]
Use : Short Name Field
Set as : "Event"
Style : PW Col Head Style
Width : 16

[Part : PW DE Body Part]
Lines : PW DE Data Line
Repeat : PW DE Data Line : PW Detailed Latest
Scroll : Vertical
Common Border : Yes

[Line : PW DE Data Line]
Key : PW DE Line Enter
Fields : PW DE D Date, PW DE D Vch, PW DE D Emp, PW DE D Cat, PW DE D Amt, PW DE D Ev

[Field : PW DE D Date]
Use : Name Field
Set as : @@PWFlat3
Width : 11
[Field : PW DE D Vch]
Use : Name Field
Set as : @@PWFlat4
Width : 12
[Field : PW DE D Emp]
Use : Name Field
Set as : @@PWFlat1
Width : 20
[Field : PW DE D Cat]
Use : Name Field
Set as : @@PWFlat7
Width : 12
[Field : PW DE D Amt]
Use : Amount Field
Set as : @@PWDE Row Amount
Width : 12
[Field : PW DE D Ev]
Use : Name Field
Set as : @@PWFlat6
Width : 16

[Key : PW DE Line Enter]
Key : Enter
Action : CALL : PW DE Show Detail

[Function : PW DE Show Detail]
01 : SET : SV PW Ledger Name : $Name
02 : Display : PW Detailed Expense Detail

[Part : PW DE Footer Part]
Lines : PW DE Footer Line
Border : Thin Top

[Line : PW DE Footer Line]
Field : PW DE Foot Count

[Field : PW DE Foot Count]
Use : Name Field
Set as : "If empty, sync Detailed Expense from PesoWise then Ctrl+Alt+R."
Width : 80

