# Production environment (names only — do not commit secrets)
# Activate only at final cutover on the new PesoWise API + PostgreSQL + MinIO stack.

# Frontend (new production build — separate from pesowise-frontend Supabase env)
VITE_API_URL=https://api.example.pesowise.internal
VITE_MIGRATION_STAGING=false

# Backend
APP_ENV=production
MIGRATION_STAGE=false
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pesowise
SESSION_SECRET=
FRONTEND_ORIGIN=https://app.example.pesowise.internal

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=stub
MINIO_OBJECT_PREFIX=storage-single-tenant

EXPECTED_DB_CONTAINER=pesowise-primary-postgres
EXPECTED_MINIO_CONTAINER=pesowise-minio-migration-v2

# Forbidden (must not point at old Supabase in production API)
FORBIDDEN_SUPABASE_HOST=pesowise-backup-supabase
FORBIDDEN_SUPABASE_DB_CONTAINER=supabase-db-kar0ro1k6jiyfxzzw7acnsza
FORBIDDEN_PRODUCTION_MINIO_CONTAINER=supabase-minio-kar0ro1k6jiyfxzzw7acnsza
